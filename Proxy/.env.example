OPENAI_API_KEY=sk-your-key-here
# Budget for one OpenAI Responses call (ms); default 300000 (5 minutes).
OPENAI_TIMEOUT_MS=300000
PORT=8787
GARMIN_SERVICE_URL=http://127.0.0.1:8788
GARMIN_SYNC_STATE_PATH=.data/garmin-sync-state.json
OPENAI_TELEMETRY_PATH=.data/openai-usage.jsonl
OPENAI_TELEMETRY_STDOUT=1

# Shared app credential. When set, every route except GET /health needs the
# header X-Lockin-App-Token with this value (else 401). Unset = open proxy
# (a warning is logged at startup). Generate with: openssl rand -base64 32
LOCKIN_APP_TOKEN=
# Comma-separated models the coach may use. Requests for any other model fall
# back to the default (gpt-6.1-sol). Unset = gpt-6.1-sol,gpt-5.5,gpt-5-mini.
COACH_ALLOWED_MODELS=
# HMAC secret for /v1 storage bearer tokens (valid 180 days). Required when
# NODE_ENV=production: without it /v1 answers 503 instead of using the
# built-in development secret.
LOCKIN_AUTH_SECRET=
# NODE_ENV=production
AUTO_PLAN_STATE_PATH=.data/auto-plan-state.json
